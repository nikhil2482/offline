# Copy to .env and change every value. Never commit .env.
POSTGRES_PASSWORD=replace_with_a_long_random_value

# offline or cloud. Cloud mode also needs compose.connected.yaml and an API key.
OFFLINE_MODE=offline
OFFLINE_ANTHROPIC_API_KEY=

# Set these to the output of `id -u` and `id -g` so the api can write to ./data.
OFFLINE_UID=1000
OFFLINE_GID=1000
